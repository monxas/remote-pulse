{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Remote-Pulse Groups Configuration",
  "description": "Declarative group configuration schema",
  "type": "object",
  "required": ["groups"],
  "properties": {
    "groups": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_-]{0,99}$": {
          "type": "object",
          "required": ["description", "access_users", "auto_distribute_keys"],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "access_users": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "email"
              },
              "uniqueItems": true
            },
            "auto_distribute_keys": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
