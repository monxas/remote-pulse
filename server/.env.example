# PostgreSQL connection URL (asyncpg driver required)
POSTGRES_URL=postgresql+asyncpg://rp:password@localhost:5432/remote_pulse

# JWT secret for enrollment token signing (HS512)
# Generate with: openssl rand -hex 32
JWT_SECRET=your-secret-key-here-minimum-32-characters

# Server public URL returned to agents
SERVER_URL=http://localhost:8080

# Agent heartbeat interval (seconds)
HEARTBEAT_INTERVAL_S=30

# Logging level
LOG_LEVEL=INFO
