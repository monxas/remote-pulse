[Unit]
Description=Remote-Pulse SSH Keys Sync
Documentation=https://github.com/monxas/remote-pulse
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/rp keys sync
User=root
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/rp

[Install]
WantedBy=multi-user.target
