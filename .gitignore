# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/

# But: SvelteKit dashboard library code lives at web/src/lib/ — make sure
# the broad `lib/` Python rule above does not eat it (ADR-0009 Phase 0).
!web/src/lib/
!web/src/lib/**
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# uv
.venv/
.uv/

# Pytest
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Mypy / Pyright
.mypy_cache/
.dmypy.json
.pyre/
.pytype/

# Ruff
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Local config / secrets (never commit)
.env
.env.local
*.local
config.local.toml
secrets/
*.key
*.pem

# Build artifacts
# PyInstaller temp specs (NOT rp.spec which is source-tracked)
*.spec
!agent/rp.spec
*.exe
*.app
*.msi
*.dmg
*.deb
*.rpm

# Logs
*.log
logs/

# OS
Thumbs.db
.DS_Store

# Project-specific
/var/lib/rp/
/etc/rp/

# ADR-0009 Phase 0 — SvelteKit dashboard build artifacts.
# Source lives in web/, built output is generated by scripts/build_dashboard.sh
# (or CI) and staged into server/src/rp_server/static/dash-next/.
# Only the .gitkeep sentinel is tracked so the directory exists for the wheel.
web/node_modules/
web/build/
web/.svelte-kit/
web/package/
web/playwright-report/
web/test-results/
web/.vitest-cache/
server/src/rp_server/static/dash-next/*
!server/src/rp_server/static/dash-next/.gitkeep
