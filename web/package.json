{
  "name": "rp-web",
  "version": "0.1.0-phase0",
  "private": true,
  "description": "Remote-Pulse SvelteKit dashboard (ADR-0009). Mounted by the FastAPI server at /dash-next/.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "npm run test:unit -- --run",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "lighthouse": "lhci autorun --config=./lighthouserc.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "22.20.3",
    "@types/qrcode": "^1.5.6",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.7",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.7"
  },
  "overrides": {
    "picomatch": "^4.0.7"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@lucide/svelte": "1.47.0",
    "@radix-ui/colors": "3.0.0",
    "@tanstack/svelte-query": "^5.90.2",
    "bits-ui": "2.19.2",
    "clsx": "2.1.1",
    "qrcode": "^1.5.4",
    "svelte-sonner": "1.2.1",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "uplot": "^1.6.32"
  }
}
